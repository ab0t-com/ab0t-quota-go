    {"micros": 9007199254740991, "out": "9007199254.740991"},
    {"micros": 9007199254740992, "error": "range"},
    {"micros": -9007199254740992, "error": "range"}
  ],
  "cost": [
    {"rate": "0.36", "seconds": "300", "out": "0.03", "note": "exact"},
    {"rate": "2.5", "seconds": "3600", "out": "2.5"},
    {"rate": "0.1", "seconds": "86400", "out": "2.4"},
    {"rate": "123.456789", "seconds": "7200", "out": "246.913578"},
    {"rate": "0.10", "seconds": "1", "out": "0.000028", "note": "0.0000277... rounds up (every mode agrees)"},
    {"rate": "1", "seconds": "0.0019", "out": "0.000001", "note": "0.000000527... rounds up (every mode agrees)"},
    {"rate": "1", "seconds": "0.0018", "out": "0.000001", "note": "tie 0.0000005 -> up (1); HALF_EVEN would give 0"},
    {"rate": "1", "seconds": "0.0054", "out": "0.000002", "note": "tie 0.0000015 -> up (2)"},
    {"rate": "1", "seconds": "0.009", "out": "0.000003", "note": "tie 0.0000025 -> up (3); HALF_EVEN would give 0.000002"},
    {"rate": "0.000001", "seconds": "1800", "out": "0.000001", "note": "tie 0.5 micro-unit -> up (1); HALF_EVEN would give 0"},
    {"rate": "0.000001", "seconds": "5400", "out": "0.000002", "note": "tie 1.5 micro-units -> up (2)"},
    {"rate": "0.000061", "seconds": "60", "out": "0.000002", "note": "1.0166... micro-units -> up (2); HALF_EVEN and HALF_UP both give 0.000001"},
    {"rate": "0.000001", "seconds": "1", "out": "0.000001", "note": "0.000277... micro-units -> up (1): any nonzero remainder costs one micro-unit; HALF_EVEN and HALF_UP both give 0"},
    {"rate": "1", "seconds": "3.6", "out": "0.001", "note": "exact: ROUND_UP never moves an exact result"},
    {"rate": "-1", "seconds": "0.0018", "out": "-0.000001", "note": "negative tie -0.0000005 -> away from zero (-1); HALF_EVEN would give 0"},
    {"rate": "-0.000061", "seconds": "60", "out": "-0.000002", "note": "negative: -1.0166... micro-units -> away from zero (-2), never toward it"},
    {"rate": "0.5", "seconds": "0", "out": "0"}
  ],
  "heartbeats": [
    {"rate": "0.36", "interval_seconds": "300", "beats": 1000, "summed_out": "30", "derived_out": "30",
     "note": "every per-beat cost is exact, so the sum of 1000 beats is exactly 30"},
    {"rate": "0.10", "interval_seconds": "1", "beats": 3600, "summed_out": "0.1008", "derived_out": "0.1",
     "note": "each 1 s beat rounds 0.0000277... up to 0.000028; summing per-beat costs drifts to 0.1008 while the cost derived from the whole elapsed time is exactly 0.1 - derive, do not accumulate"}
  ]
