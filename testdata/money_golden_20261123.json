    {"in": " 5 ", "out": "5", "micros": 5000000},
    {"in": "+5", "out": "5", "micros": 5000000},
    {"in": "-1.666667", "out": "-1.666667", "micros": -1666667},
    {"in": "-0", "out": "0", "micros": 0},
    {"in": "-0.000000", "out": "0", "micros": 0},
    {"in": ".5", "out": "0.5", "micros": 500000},
    {"in": "5.", "out": "5", "micros": 5000000},
    {"in": "007.50", "out": "7.5", "micros": 7500000},
