    {"in": "123456789.123457", "out": "123456789.123457", "micros": 123456789123457},
    {"in": "9007199254.740991", "out": "9007199254.740991", "micros": 9007199254740991},
    {"in": "-9007199254.740991", "out": "-9007199254.740991", "micros": -9007199254740991},
