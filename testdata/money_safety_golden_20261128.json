  "jwt_startup_warning_template": "tier_provider \"jwt\" reads the token claim \"{claim}\": tokens issued by the ab0t auth service (https://auth.service.ab0t.com) carry no tier claim, so unless your own token issuer adds \"{claim}\" every customer resolves to default_tier \"{default_tier}\" — for ab0t-issued tokens use \"tier_provider\": {\"type\": \"mesh\"} (the tier billing holds for the org)",
  "jwt_missing_claim_warning_template": "tier_provider \"jwt\": a token carried no \"{claim}\" claim — this customer resolved to default_tier \"{default_tier}\" (logged once per process)",
  "price_list_403": {
    "interval_seconds": 21600,
